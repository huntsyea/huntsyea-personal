---
import Base from "@/layouts/Base.astro";
---

<Base title="Page not found">
  <section class="flex min-h-64 flex-col justify-center gap-4">
    <p class="text-sm text-fg-muted">404</p>
    <h1>Page not found</h1>
    <p class="max-w-md text-fg-muted">
      This category, post, or page does not exist.
    </p>
    <a
      class="w-fit underline decoration-fg-subtle decoration-1 underline-offset-2 transition-colors hover:text-accent-fg hover:decoration-accent"
      href="/">Return home</a
    >
  </section>
</Base>
