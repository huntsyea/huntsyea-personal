---
import ThemeSwitcher from "./ThemeSwitcher.astro";

/**
 * The shared footer on every route except home: Contact links with the Theme
 * control opposite, and a copyright line beneath.
 */
interface Props {
  siteTitle: string;
  contact: readonly { label: string; url: string; target?: string | null }[];
}

const { siteTitle, contact } = Astro.props;
const year = new Date().getFullYear();
---

<footer
  class="mx-auto w-full max-w-column px-6 pb-[var(--space-page)] md:pb-[var(--space-page-desktop)]"
>
  <div class="flex flex-col gap-y-3 border-t border-border pt-4">
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <nav aria-label="Contact links">
        <ul class="m-0 flex list-none flex-wrap gap-x-4 gap-y-1 p-0">
          {
            contact.map((item) => (
              <li class="m-0 list-none p-0">
                <a
                  href={item.url}
                  target={item.target ?? undefined}
                  rel={
                    item.target === "_blank" ? "noopener noreferrer" : undefined
                  }
                  class="text-fg-muted transition-colors hover:text-fg"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ThemeSwitcher />
    </div>
    <p class="m-0 text-sm text-fg-muted">© {year} {siteTitle}</p>
  </div>
</footer>
