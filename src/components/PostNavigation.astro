---
interface Props {
  category: string;
  previous?: { slug: string; title: string };
  next?: { slug: string; title: string };
}

const { category, previous, next } = Astro.props;
---

{
  (previous || next) && (
    <div class="mt-16 flex w-full justify-between border-t border-border pt-8">
      {previous && (
        <a
          href={`/${category}/${previous.slug}`}
          class="flex w-full flex-col gap-1 text-left"
        >
          <span class="text-fg-muted">Previous</span>
          <span>{previous.title}</span>
        </a>
      )}
      {next && (
        <a
          href={`/${category}/${next.slug}`}
          class="flex w-full flex-col gap-1 text-right"
        >
          <span class="text-fg-muted">Next</span>
          <span>{next.title}</span>
        </a>
      )}
    </div>
  )
}
