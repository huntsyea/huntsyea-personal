---
import ChevronRight from "./icons/ChevronRight.astro";

export type BreadcrumbItem = { label: string; href: string };

interface Props {
  items: readonly BreadcrumbItem[];
}

const trail = [{ label: "Home", href: "/" }, ...Astro.props.items];
const last = trail[trail.length - 1];
---

<nav aria-label="Breadcrumb" class="mt-0 mb-stack w-full text-sm font-normal">
  <ol class="flex list-none items-center gap-1 align-middle">
    {
      trail.map((item, index) => (
        <>
          {index > 0 && (
            <li aria-hidden="true">
              <ChevronRight class="text-fg-muted" />
            </li>
          )}
          <li>
            {item === last ? (
              <span aria-current="page" class="text-fg-muted">
                {item.label}
              </span>
            ) : (
              <a
                href={item.href}
                class="text-fg-muted transition-colors hover:text-fg"
              >
                {item.label}
              </a>
            )}
          </li>
        </>
      ))
    }
  </ol>
</nav>
