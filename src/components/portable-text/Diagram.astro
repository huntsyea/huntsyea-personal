---
/**
 * The Diagram block (plugin-diagram): a light and a dark Media Library image
 * that follow the active Theme. EmDash's Image renders both as responsive
 * WebP and shows the one matching the `dark`/`light` class on <html>.
 *
 * The block's media pickers store file URLs, which carry no dimensions, and
 * the image service needs dimensions to build a srcset. Each URL's storage
 * key is looked up in the Media Library through EmDash's runtime database.
 */
import type { MediaValue } from "emdash";

import { getDb } from "emdash/runtime";
import { Image } from "emdash/ui";

type Node = { light?: string; dark?: string; alt?: string; caption?: string };

const MEDIA_FILE_PATH = "/_emdash/api/media/file/";

const { node } = Astro.props as { node: Node };

const db = await getDb();

/**
 * Dimensions for a picked Media Library URL. EmDash has no public lookup from a
 * storage-key URL, so this reads its `media` table; if that query ever fails
 * (for example after an EmDash schema change), the diagram still renders as a
 * plain full-size image instead of breaking the page.
 */
async function lookup(storageKey: string) {
  try {
    return await db
      .selectFrom("media")
      .select(["id", "width", "height", "blurhash", "dominant_color"])
      .where("storage_key", "=", storageKey)
      .where("status", "=", "ready")
      .executeTakeFirst();
  } catch (error) {
    console.warn("[diagram] media lookup failed", storageKey, error);
    return undefined;
  }
}

async function resolve(url: string | undefined): Promise<MediaValue | null> {
  if (!url) return null;
  const storageKey = url.startsWith(MEDIA_FILE_PATH)
    ? decodeURIComponent(url.slice(MEDIA_FILE_PATH.length))
    : undefined;
  const media = storageKey ? await lookup(storageKey) : undefined;
  return {
    id: media?.id ?? "",
    src: url,
    width: media?.width ?? undefined,
    height: media?.height ?? undefined,
    blurhash: media?.blurhash ?? undefined,
    dominantColor: media?.dominant_color ?? undefined,
  };
}

const [light, dark] = await Promise.all([
  resolve(node.light),
  resolve(node.dark),
]);

// Diagrams fill the 36rem reading column. Phones scroll a 576px image and
// can tap to open it wider, so the srcset stays sharp at that size.
const sizes = "(max-width: 639px) 760px, 576px";
const widths = [400, 576, 800, 1152, 1520].filter(
  (width) => !light?.width || width <= light.width,
);
// EmDash's Image forwards extra props to Astro's <Image>, but types them as
// <img> attributes, so Astro-only options are passed through untyped.
const astroImageProps: Record<string, unknown> = { widths, quality: 95 };
---

{
  light && (
    <figure class="emdash-image" data-diagram>
      <Image
        image={light}
        darkVariant={dark}
        alt={node.alt ?? ""}
        sizes={sizes}
        {...astroImageProps}
      />
      {node.caption && <figcaption>{node.caption}</figcaption>}
    </figure>
  )
}

<script>
  const homes = new WeakMap<HTMLElement, Comment>();

  const closeDiagram = (diagram: HTMLElement) => {
    diagram.removeAttribute("data-zoomed");
    const mark = homes.get(diagram);
    mark?.parentNode?.insertBefore(diagram, mark);
    mark?.remove();
    homes.delete(diagram);
  };

  document.addEventListener("click", (event) => {
    if (!window.matchMedia("(max-width: 639px)").matches) return;
    const target = event.target;
    if (!(target instanceof Element)) return;
    const diagram = target.closest("[data-diagram]");
    if (!(diagram instanceof HTMLElement)) return;
    if (diagram.hasAttribute("data-zoomed")) {
      closeDiagram(diagram);
      return;
    }
    const mark = document.createComment("diagram");
    diagram.parentNode?.insertBefore(mark, diagram);
    homes.set(diagram, mark);
    document.body.appendChild(diagram);
    diagram.setAttribute("data-zoomed", "");
  });

  const closeZoomed = () => {
    for (const diagram of document.querySelectorAll(
      "[data-diagram][data-zoomed]",
    )) {
      if (diagram instanceof HTMLElement) closeDiagram(diagram);
    }
  };

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeZoomed();
  });

  window
    .matchMedia("(max-width: 639px)")
    .addEventListener("change", (event) => {
      if (!event.matches) closeZoomed();
    });
</script>
