---
import type { OutlineItem } from "@/lib/content";
import type { PortableTextBlock } from "emdash";

import { fixPortableTextTypos } from "@/lib/content";

import { PortableText } from "emdash/ui";

import Block from "./Block.astro";
import Code from "./Code.astro";
import Diagram from "./Diagram.astro";

/**
 * Renders a Portable Text field in the Site's prose styles. Pass the Post
 * outline so headings carry the ids the "On this page" navigation links to.
 */

interface Props {
  value: PortableTextBlock[] | undefined;
  outline?: readonly OutlineItem[];
  class?: string;
  /** Render the blocks without the `.prose` wrapper, inside an existing one. */
  bare?: boolean;
}

const {
  value: source,
  outline = [],
  class: className,
  bare = false,
} = Astro.props;
const value = fixPortableTextTypos(source);
(Astro.locals as { headingIds?: Map<string, string> }).headingIds = new Map(
  outline.map((item) => [item.key, item.id]),
);
const components = { block: Block, type: { code: Code, diagram: Diagram } };
---

{
  value && value.length > 0 && bare ? (
    <PortableText value={value} components={components} />
  ) : value && value.length > 0 ? (
    <div class:list={["prose", className]}>
      <PortableText value={value} components={components} />
    </div>
  ) : null
}
