---
/**
 * The shared bordered row. Every list on the Site (Posts, Projects,
 * Favorites) renders through this primitive so rows behave, hover, and focus
 * identically everywhere. Wrap rows in `<ul class="m-0 list-none p-0">`.
 */
interface Props {
  title: string;
  href: string;
  /** Optional caption (a favorite note or hostname) rendered under the title. */
  caption?: string;
  /** Shared-element view-transition name with the destination heading. */
  transitionName?: string;
  newTab?: boolean;
  /** EmDash visual-editing markers (`entry.edit.<field>`); empty outside edit mode. */
  titleEdit?: Record<string, unknown>;
  captionEdit?: Record<string, unknown>;
}

const {
  title,
  href,
  caption,
  transitionName,
  newTab = false,
  titleEdit,
  captionEdit,
} = Astro.props;
---

<li class="m-0 list-none border-t border-border">
  <a
    href={href}
    target={newTab ? "_blank" : undefined}
    rel={newTab ? "noopener noreferrer" : undefined}
    class="-mx-2 flex w-full justify-between rounded px-2 py-2 transition-colors hover:bg-bg-subtle"
  >
    <span
      class={caption ? "flex flex-col" : undefined}
      style={transitionName
        ? { viewTransitionName: transitionName }
        : undefined}
    >
      <span {...titleEdit}>
        {title}
        {newTab && <span aria-hidden="true"> ↗</span>}
      </span>
      {
        caption && (
          <span class="text-fg-muted" {...captionEdit}>
            {caption}
          </span>
        )
      }
    </span>
    <slot name="meta" />
  </a>
</li>
