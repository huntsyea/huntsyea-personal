{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huntsyea-personal",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  // EMDASH_SITE_URL (https://huntsyea.com) is a Worker variable set by
  // `pnpm deploy`. keep_vars stops any other deploy from removing it: EmDash
  // needs it for passkeys, CSRF checks, and image optimization.
  "keep_vars": true,
  // Run next to the D1 primary (created in ENAM); public pages make several
  // D1 round trips per render.
  "placement": { "mode": "targeted", "region": "aws:us-east-1" },
  // Edge cache for anonymous HTML. Admin, preview, and signed-in responses
  // are stripped in src/worker.ts. See docs/adr/0004-anonymous-html-edge-cache.md.
  "cache": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "huntsyea-personal",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "huntsyea-media",
    },
  ],
  // Workers Custom Domains: Cloudflare manages the DNS records and
  // certificates for both hostnames. `www` redirects to the apex in
  // src/worker.ts.
  "routes": [
    { "pattern": "huntsyea.com", "custom_domain": true },
    { "pattern": "www.huntsyea.com", "custom_domain": true },
  ],
  // Scheduled publishing, backups, and EmDash maintenance.
  "triggers": {
    "crons": ["* * * * *"],
  },
}
