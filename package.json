{
  "name": "huntsyea-personal",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.23.0 <12"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format:write": "prettier . --write --log-level warn",
    "format:check": "prettier . --check --log-level warn",
    "lint:style": "stylelint \"**/*.css\"",
    "lint:style:fix": "stylelint \"**/*.css\" --fix",
    "lint:eslint": "eslint .",
    "lint": "stylelint \"**/*.css\" && eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "verify": "prettier . --check --log-level warn && stylelint \"**/*.css\" && eslint . && tsc --noEmit && vitest run && next build && playwright test"
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-icons": "^1.3.2",
    "clsx": "^2.1.1",
    "framer-motion": "13.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "1.33.0",
    "next": "16.3.2",
    "next-mdx-remote": "6.0.0",
    "next-themes": "^0.4.6",
    "next-view-transitions": "^0.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reading-time-estimator": "2.13.0",
    "rehype-pretty-code": "0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "unist-util-visit": "5.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.2",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-recess-order": "7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
